# Copy to .env and fill in. Never commit .env.

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=change-me

# You log in with this address and password; it is also the only allowed panel user.
PANEL_USER=you@example.com
# A bcrypt hash of your password, made with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# Keep the single quotes: the hash contains $ signs.
PANEL_PASSWORD_HASH='$2a$14$replace.with.your.own.hash'

# Optional: without it the rules and spam checks still run, but there is no AI triage or drafts.
OPENAI_API_KEY=

# Report what would happen without changing any mailbox. Set false once you trust it.
DRY_RUN=true
RUN_INTERVAL_MINUTES=15

# Where Caddy listens. Keep 127.0.0.1 unless you add TLS (see the README).
LISTEN=127.0.0.1:8080
# The https address of the panel, needed only for Office 365 / Gmail sign-in.
PUBLIC_URL=
# Office 365 with a single-tenant app registration: your Entra tenant ID or domain.
MICROSOFT_TENANT_ID=common
# Set to your domain (and publish ports 80 and 443) to let Caddy fetch a TLS certificate.
SITE_ADDRESS=:80
